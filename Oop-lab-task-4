class Account {
    String accountHolder;
    double balance;
    Account(String accountHolder, double balance) {
        this.accountHolder = accountHolder;
        this.balance = balance;
    }
    void displayAccountInfo() {
        System.out.println("Account Holder: " + accountHolder);
        System.out.println("Balance: " + balance);
    }
}
class SavingsAccount extends Account {
    double interestRate;
    SavingsAccount(String accountHolder, double balance, double interestRate) {
        super(accountHolder, balance);
        this.interestRate = interestRate;
    }
    @Override
    void displayAccountInfo() {
        System.out.println("\n--- Savings Account ---");
        super.displayAccountInfo();
        System.out.println("Interest Rate: " + interestRate + "%");
        System.out.println("Benefit: Earns Interest on Savings");
    }
}
class CurrentAccount extends Account {
    double overdraftLimit;
    CurrentAccount(String accountHolder, double balance, double overdraftLimit) {
        super(accountHolder, balance);
        this.overdraftLimit = overdraftLimit;
    }
    @Override
    void displayAccountInfo() {
        System.out.println("\n--- Current Account ---");
        super.displayAccountInfo();
        System.out.println("Overdraft Limit: " + overdraftLimit);
        System.out.println("Benefit: Allows Business Transactions");
    }
}
public class Main {
    public static void main(String[] args) {
        SavingsAccount s1 = new SavingsAccount("Ahmad", 50000, 5.5);
        CurrentAccount c1 = new CurrentAccount("Ali", 100000, 20000);
        s1.displayAccountInfo();
        c1.displayAccountInfo();
    }
}
